# Copy to .env.docker for local Docker development. Replace the example values.
DOCKER_SECRET_KEY=replace-with-a-generated-local-secret-key
DOCKER_DJANGO_DEBUG=true

DOCKER_WEB_PORT=8000
DOCKER_ALLOWED_HOSTS=localhost,127.0.0.1,web
DOCKER_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DOCKER_CSRF_COOKIE_SECURE=false
DOCKER_SESSION_COOKIE_SECURE=false
DOCKER_SECURE_CONTENT_TYPE_NOSNIFF=true
DOCKER_SESSION_COOKIE_AGE=1209600
DOCKER_SESSION_SAVE_EVERY_REQUEST=false
DOCKER_SECURE_PROXY_SSL_HEADER=
DOCKER_USE_X_FORWARDED_HOST=false

DOCKER_DB_NAME=lumix_ai
DOCKER_DB_USER=lumix_ai_user
DOCKER_DB_PASSWORD=replace-with-a-local-database-password
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432

# Local email is printed by Django in the web container logs. Configure SMTP to send real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@lumixai.local
CONTACT_EMAIL=your-inbox@example.com

# Maximum Wagtail document upload size, in bytes (100 MB)
DOCKER_WAGTAILDOCS_MAX_UPLOAD_SIZE=104857600

# Optional Australian bank transfer details. Fill in all three to enable transfers.
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_BSB=
BANK_TRANSFER_ACCOUNT_NUMBER=

STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ORIGIN=http://localhost:8000