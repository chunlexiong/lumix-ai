# Copy to .env.prod on the VPS. Do not commit .env.prod.
DOCKER_SECRET_KEY=replace-with-a-generated-production-secret-key
DOCKER_DJANGO_DEBUG=false

# Point these hostnames at the VPS and allow inbound ports 80 and 443.
CADDY_ACME_EMAIL=admin@example.com
CADDY_SITE_HOSTS=example.com www.example.com

DOCKER_ALLOWED_HOSTS=example.com,www.example.com
DOCKER_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DOCKER_CSRF_COOKIE_SECURE=true
DOCKER_SESSION_COOKIE_SECURE=true
DOCKER_SECURE_CONTENT_TYPE_NOSNIFF=true
DOCKER_SESSION_COOKIE_AGE=1209600
DOCKER_SESSION_SAVE_EVERY_REQUEST=true
DOCKER_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
DOCKER_USE_X_FORWARDED_HOST=true

DOCKER_DB_NAME=lumix_ai
DOCKER_DB_USER=lumix_ai_user
DOCKER_DB_PASSWORD=replace-with-a-strong-production-database-password
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432
DOCKER_GUNICORN_WORKERS=2
